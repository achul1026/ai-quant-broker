# 한국투자증권 OpenAPI (D3 — Phase 4에서 사용)
# 실전 계좌와 모의 계좌 키가 다르다. 둘 다 .env에 채울 때 분리해서 관리.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=
KIS_MODE=paper  # paper | real — 실전 자금 투입 게이트(RISK.md) 통과 전에는 절대 real 금지

# Database (Phase 1 — PostgreSQL + TimescaleDB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aiqb
DB_USER=aiqb
DB_PASSWORD=

# LLM (Phase 2 — D4에서 최종 모델 확정)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 알림 (Phase 4 — Slack 장애 알림)
SLACK_WEBHOOK_URL=
